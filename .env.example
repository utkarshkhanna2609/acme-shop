# Copy to .env to change behaviour, then: docker compose up -d
DEPLOY_ENV=production
# Requests per second from the load generator.
LOADGEN_RPS=4
# Share of charges that fail with "card processor timeout" (0.03 = 3%).
PAYMENTS_FAIL_RATE=0.03
# Added to every charge, to simulate a slow processor.
PAYMENTS_EXTRA_LATENCY_MS=0
# Share of orders that stall 1.5 s in the database.
ORDERS_SLOW_RATE=0.02
